# Cấu hình Odoo & PostgreSQL (Mẫu)
ODOO_IMAGE=odoo:18.0
POSTGRES_IMAGE=postgres:16

# Cổng truy cập Web Odoo trên máy chủ (http://localhost:8069)
WEB_PORT=8069

# Mật khẩu Master Password dùng để tạo, backup, restore database Odoo
ADMIN_PASSWORD=admin

# Thông tin cơ sở dữ liệu PostgreSQL
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo
POSTGRES_DB=postgres
